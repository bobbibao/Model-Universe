# --- LLM (swap providers via env only; see infrastructure/reasoning/llm_factory.py)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_API_BASE=http://localhost:11434

REASONER=rule_based
# REASONER=llm   # requires ROADMAP T-01

# --- Postgres: one instance, two schemas (shop owned by web, ci owned by the agent) ---
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/sme
SHOP_READ_DSN=postgresql://ci_reader:reader@localhost:5432/sme

# --- Web <-> Agent ---
WEB_BASE_URL=http://localhost:6050
SHOP_API_BASE_URL=http://localhost:6050/api/agent/v1
SHOP_API_TOKEN=change-me
WEB_EVENTS_URL=http://localhost:6050/api/agent/v1/events
WEB_EVENTS_SECRET=change-me
SIGNING_SECRET=change-me
# Web user -> agent: the web proxy mints short-lived actor JWTs with this secret (same value in
# apps/web-ecommerce/.env). At least 32 bytes; must differ from the web's JWT_SECRET.
AGENT_ACTOR_SECRET=change-me

# --- Shop reads: none | fake (dev only: FakeShop data until T-03's SQL adapter lands) ---
SHOP_READ_ADAPTER=none

# --- Approvers (JSON list; user_id = web user id). Interim until T-08 loads them from the web app ---
# RECIPIENTS_FILE=./recipients.json

# --- Notification channels (leave blank to disable) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ZALO_ACCESS_TOKEN=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=agent@example.com

# --- Operations ---
# dev | production (production refuses to start with change-me secrets)
APP_ENV=dev
AUTONOMY_MODE=always_ask
MAX_AUTO_APPROVE_COST=200
QUESTION_TTL_HOURS=48
SIGNAL_COOLDOWN_HOURS=72
SCHEDULER_INTERVAL_MINUTES=15

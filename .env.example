# --- Reasoner (ROADMAP T-01, docs/adr/0008). rule_based is the default; llm explains findings and writes questions
# and lessons with an LLM, and falls back to the rules on any failure.
REASONER=rule_based
# REASONER=llm
LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b                  # default per provider: qwen2.5:3b (ollama), claude-sonnet-5 (claude)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_NUM_CTX=8192
LLM_TEMPERATURE=0.1                     # Ollama only, 0 to 0.2
LLM_COOLDOWN_SECONDS=60                 # skip the LLM this long after a timeout or an unreachable provider
# Claude: set the key in your environment or your untracked .env, never here.
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=
CLAUDE_TIMEOUT_SECONDS=30
LLM_DAILY_BUDGET_USD=2                  # Claude only; per UTC day, kept in the agent database

# --- Postgres: one instance. The agent's own database (improvements, cases, logs): role and database created once by
# infra/sql/ci_agent.sql; the agent creates its tables at startup. PERSISTENCE_ADAPTER=memory loses everything on
# restart (development only).
PERSISTENCE_ADAPTER=postgres
DATABASE_URL=postgresql://ci_agent:<ci_agent password>@localhost:5432/ci_agent
# Read-only role created by infra/sql/ci_reader.sql; the database is the web shop's (DB_NAME in apps/web-ecommerce/.env).
SHOP_READ_DSN=postgresql://ci_reader:<ci_reader password>@localhost:5432/web-ecommerce

# --- Web <-> Agent ---
WEB_BASE_URL=http://localhost:6050
SHOP_API_BASE_URL=http://localhost:6050/api/agent/v1
SHOP_API_TOKEN=change-me
WEB_EVENTS_URL=http://localhost:6050/api/agent/v1/events
WEB_EVENTS_SECRET=change-me
SIGNING_SECRET=change-me
# Web user -> agent: the web proxy mints short-lived actor JWTs with this secret (same value in
# apps/web-ecommerce/.env). At least 32 bytes; must differ from the web's JWT_SECRET.
AGENT_ACTOR_SECRET=change-me

# --- Shop reads: sql (default; needs SHOP_READ_DSN above) | fake (development only: in-memory FakeShop data) ---
SHOP_READ_ADAPTER=sql
# The agent's internal money unit in VND: shop amounts are divided by it, API amounts multiplied back.
# MAX_AUTO_APPROVE_COST and the other thresholds are in this unit (200 units = 5,000,000 VND).
MONEY_UNIT_VND=25000

# --- Approvers (JSON list; user_id = web user id). Interim until T-08 loads them from the web app ---
# RECIPIENTS_FILE=./recipients.json

# --- Notification channels (leave blank to disable) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ZALO_ACCESS_TOKEN=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=agent@example.com

# --- Operations ---
# dev | production (production refuses to start with change-me secrets)
APP_ENV=dev
AUTONOMY_MODE=always_ask
MAX_AUTO_APPROVE_COST=200
QUESTION_TTL_HOURS=48
SIGNAL_COOLDOWN_HOURS=72
# Scheduler (T-09): unset = on with APP_ENV=production, off in dev. Minutes from the end of one run to the next.
# Run a single agent process (runs and improvements are serialised per process).
# SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15
# Demo only, refused with APP_ENV=production: measure N minutes after Act instead of the plan's 14 days.
# DEMO_MEASURE_AFTER_MINUTES=3

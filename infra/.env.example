# Copy to infra/.env (git-ignored) and replace every <value>; compose refuses to start while a required one is missing.
# Use letters and digits only, so the values need no URL encoding. Secrets used for HS256 need at least 32 characters.
# The e2e workflow writes infra/.env from this file plus generated secrets.

# --- Database roles (infra/sql) ---
POSTGRES_PASSWORD=<postgres superuser password>
CI_READER_PASSWORD=<ci_reader password (read-only analytics views)>
SHOP_AGENT_PASSWORD=<shop_agent password (the agent's own database)>

# --- Web <-> agent ---
AGENT_API_TOKEN=<agent -> web Agent API bearer token>
AGENT_ACTOR_SECRET=<web -> agent actor tokens, at least 32 characters>
AGENT_APPROVAL_SECRET=<approval grants, web only, at least 32 characters>

# --- Web image ---
WEB_ENVIRONMENT=<suffix of apps/web-ecommerce/.env.<suffix> baked into the web image>

# --- Optional ---
# APP_ENV=dev
# LLM_PROFILE=local                      # local | local-small | local-large | anthropic | openai | google | scripted
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# ANTHROPIC_API_KEY=
# SHOP_ADAPTER=sql
# DEMO_MEASURE_AFTER_MINUTES=            # demo only; empty = off
# DB_HOST_PORT=55432
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

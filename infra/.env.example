# Copy to infra/.env (git-ignored) and replace every value; compose refuses to start while one is missing.
# Use letters and digits only, so the values need no URL encoding.
POSTGRES_PASSWORD=<postgres superuser password>
CI_READER_PASSWORD=<ci_reader password>
CI_AGENT_PASSWORD=<ci_agent password>
AGENT_API_TOKEN=<agent -> web Agent API token>
AGENT_EVENTS_SECRET=<HMAC secret for the web events webhook>
AGENT_ACTOR_SECRET=<at least 32 characters>
SIGNING_SECRET=<signed answer links>
WEB_ENVIRONMENT=<suffix of apps/web-ecommerce/.env.<suffix> baked into the web image>
# Optional: APP_ENV=dev, REASONER=rule_based, OLLAMA_BASE_URL=http://host.docker.internal:11434, DB_HOST_PORT=55432,
# SCHEDULER_ENABLED=false, WEB_PUBLIC_URL=http://localhost:6050, DEMO_MEASURE_AFTER_MINUTES= (demo only)

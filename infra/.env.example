# Configuration of the Docker stack (infra/docker-compose.yml). Copy to infra/.env (git-ignored) and replace every
# <value>; compose refuses to start while a required one is missing. Use letters and digits only, so values need no URL
# encoding. Generate secrets with `openssl rand -hex 32` (HS256 keys need at least 32 characters).

# --- Runtime ---
APP_ENV=production                       # production refuses placeholder secrets, development profiles and demo timers
WEB_DB_NAME=web_ecommerce                # the shop database; `seed` only runs against a name ending in _demo or _test

# --- Database roles (infra/sql) ---
POSTGRES_PASSWORD=<postgres superuser password>
CI_READER_PASSWORD=<ci_reader password: read-only analytics views>
SHOP_AGENT_PASSWORD=<shop_agent password: the agent's own database>

# --- Web ---
JWT_SECRET=<session JWT secret, at least 32 characters>
ADMIN_EMAIL=<first admin account, created by the seed>
ADMIN_PASSWORD=<its password>
COOKIE_SECURE=true                       # false only when the shop is served over plain HTTP (local testing)
SHOP_PUBLIC_URL=https://shop.example.com # every link sent to ad platforms and the Facebook Page is built on it

# --- Web <-> agent ---
AGENT_API_TOKEN=<agent -> web Agent API bearer token, at least 32 characters>
AGENT_ACTOR_SECRET=<web -> agent actor tokens, at least 32 characters>
AGENT_APPROVAL_SECRET=<approval grants, web only, at least 32 characters>
STEP_UP_MAX_AGE_SECONDS=300              # a high-tier approval needs the password re-entered within this window

# --- Models (apps/agent-service/config/llm/<profile>.yaml; docs/LOCAL_LLM.md) ---
LLM_PROFILE=openrouter-fast              # openrouter-fast | anthropic | openai | google | local | local-small | local-large
OPENAI_API_KEY=<provider key: OpenAI, or an OpenRouter key for openrouter-fast>
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434   # local profiles and the bge-m3 embeddings
# Decision model (TypeSafe Jev) that routes customer turns before the planner; no key = off. The default provider is
# OpenRouter's Decisions API, which reuses OPENAI_API_KEY above when LLM_PROFILE is openrouter-fast.
# DECISION_PROVIDER=openrouter            # openrouter | typesafe
# OPENROUTER_API_KEY=
# TYPESAFE_API_KEY=                       # only with DECISION_PROVIDER=typesafe
# DECISION_MODEL=

# --- Capacity ---
# AGENT_JOBS_PER_WORKER=16               # concurrent runs in the Agent Server
# ASSISTANT_MAX_CONCURRENT=16            # customer turns running at once per web process; the rest queue
# ASSISTANT_QUEUE_SECONDS=15             # how long a turn waits for a slot before "busy"
# ASSISTANT_RATE_LIMIT=60                # turns per IP per 10 minutes
# ASSISTANT_REPLY_CACHE_SECONDS=300      # shared replies to identical first questions of guests; 0 = off

# --- Email (OTP codes and admin notifications; required in production) ---
SMTP_HOST=<smtp host>                    # local testing: mailpit with `--profile mail`
SMTP_PORT=587                            # mailpit: 1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=<sender address>

# --- Checkout: the receiving account shown with deposit and full-payment transfer instructions ---
SHOP_BANK_NAME=<bank>
SHOP_BANK_ACCOUNT=<account number>
SHOP_BANK_HOLDER=<account holder>
# GHN delivery (docs/business/deposit-delivery-specification.md). Token and ShopId from the GHN account (GET shop/all).
# GHN_ORDER_MODE: live (default with a token) creates real GHN orders; simulate creates SIM... codes for testing.
# GHN_BASE_URL=https://dev-online-gateway.ghn.vn for a GHN staging account. A new shop may have lower COD/declared-value
# limits until GHN verifies it: set them so checkout asks for a larger upfront payment.
GHN_TOKEN=
GHN_SHOP_ID=
# GHN_ORDER_MODE=live
# GHN_BASE_URL=https://online-gateway.ghn.vn
# GHN_COD_LIMIT_VND=50000000
# GHN_INSURANCE_LIMIT_VND=5000000
# Custom header value configured in the GHN webhook settings (X-Webhook-Token) for POST /api/shipping/ghn/webhook.
GHN_WEBHOOK_TOKEN=
# Address suggestions and map positions from OpenStreetMap data: photon (default, photon.komoot.io) or nominatim
# (openstreetmap.org, blocked by some Vietnamese networks); GEOCODER_URL for a self-hosted instance.
# GEOCODER_PROVIDER=photon
# GEOCODER_URL=
# GEOCODER_EMAIL=
# Online payment with payOS (https://my.payos.vn): webhook URL https://<shop>/api/payments/payos/webhook.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# PAYOS_LINK_MINUTES=30
# Shop alerts on a Zalo Official Account (live) or only in Admin -> Operational alerts (off); customer shipping
# updates by Zalo ZNS with one approved template whose parameters are order_code, tracking_code and status.
ZALO_MODE=off
ZALO_OA_ACCESS_TOKEN=
ZALO_ADMIN_USER_IDS=
ZALO_ZNS_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_ID=

# --- Marketing platforms (web only; docs/MARKETING_LIVE_CHECKLIST.md). Every mode defaults to fake, which never calls
# out; live needs its credentials and an https SHOP_PUBLIC_URL, or the web refuses to start. ---
# FACEBOOK_PAGE_MODE=fake  FACEBOOK_PAGE_ID=  FACEBOOK_PAGE_ACCESS_TOKEN=  META_GRAPH_API_VERSION=v24.0
# META_ADS_MODE=fake  META_ACCESS_TOKEN=  META_AD_ACCOUNT_ID=
# GOOGLE_ADS_MODE=fake  GOOGLE_ADS_CLIENT_ID=  GOOGLE_ADS_CLIENT_SECRET=  GOOGLE_ADS_DEVELOPER_TOKEN=
#   GOOGLE_ADS_REFRESH_TOKEN=  GOOGLE_ADS_CUSTOMER_ID=  GOOGLE_ADS_LOGIN_CUSTOMER_ID=  GOOGLE_ADS_CONVERSION_ACTION_ID=
# TIKTOK_ADS_MODE=fake  TIKTOK_ACCESS_TOKEN=  TIKTOK_ADVERTISER_ID=  TIKTOK_IDENTITY_ID=  TIKTOK_EVENTS_TOKEN=
# CONVERSIONS_MODE=fake  META_CAPI_TOKEN=
# Tracking tags, built into the web image and loaded only after marketing consent:
# NEXT_PUBLIC_META_PIXEL_ID=  NEXT_PUBLIC_GOOGLE_TAG_ID=  NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=  NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Optional ---
# WEB_AGENT_SERVER_URL=http://agent-server:2024  # prod-like profile: http://agent-runtime:2026 (Aegra)
# SHOP_ADAPTER=sql
# DB_HOST_PORT=55432
# WEB_LOG_LEVEL=info
# FF_MARKET_TRENDS=true                  # the collect graph's Google Trends source
# FF_MARKET_SCRAPING=true                # competitors' own storefronts (marketplaces are always denylisted)
# LANGFUSE_PUBLIC_KEY=  LANGFUSE_SECRET_KEY=  LANGFUSE_HOST=https://cloud.langfuse.com

# --- End-to-end tests only (docs/DEMO.md section 3): APP_ENV=dev, LLM_PROFILE=scripted, DEMO_MEASURE_AFTER_MINUTES=1,
# E2E_BASE_URL=http://localhost:6050, E2E_ADMIN_EMAIL/E2E_ADMIN_PASSWORD, E2E_ALLOW_WRITES=1 ---

# Running the web outside Docker (`yarn dev`). The Docker stack is configured in infra/.env instead.

# Database settings
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=web_ecommerce

# Log settings (debug also prints every model, route and seeding step)
LOGGER=CONSOLE
LOG_LEVEL=info

# Auth settings
# Secret used to sign session JWTs (use a long random string)
JWT_SECRET=
# Session lifetime in seconds (default 604800 = 7 days)
JWT_EXPIRES_IN=604800
# Session cookie is Secure in production by default; set to false only when serving over plain HTTP
# COOKIE_SECURE=false

# First admin account, created by the seed (yarn seed-dev / seed-prod)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shop agent (apps/agent-service). Leave empty to disable the Agent API and the agent console.
# The Agent Server, called by the /api/admin/agent/server gateway (`poe dev` serves it on 2024).
AGENT_SERVER_URL=http://localhost:2024
# Bearer token the agent uses for /api/agent/v1 (= SHOP_API_TOKEN in the agent's .env)
AGENT_API_TOKEN=
# Signs the short-lived actor tokens sent to the agent (= AGENT_ACTOR_SECRET there). At least 32 bytes, not JWT_SECRET.
AGENT_ACTOR_SECRET=
# Signs approval grants (web only; the agent never holds it). At least 32 bytes, different from the secrets above.
AGENT_APPROVAL_SECRET=
STEP_UP_MAX_AGE_SECONDS=300
# Customer assistant capacity: turns running at once (the rest wait up to ASSISTANT_QUEUE_SECONDS), turns per IP per
# 10 minutes, and how long identical first questions of guests share one reply (0 = off).
ASSISTANT_MAX_CONCURRENT=16
ASSISTANT_QUEUE_SECONDS=15
ASSISTANT_RATE_LIMIT=60
ASSISTANT_REPLY_CACHE_SECONDS=300

# SMTP settings for OTP emails. Required in production; in development an empty SMTP_HOST writes the OTP to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Conversion tracking tags (public, inlined at build time). Each loads only when its id is set and the visitor accepted
# marketing cookies. Meta Pixel id (digits), Google tag id (G-... or AW-...), Google Ads conversion label, TikTok Pixel id.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# The shop's public address: every link and image the ad platforms and the Facebook Page receive is built on it
# (https in production; default http://localhost:3000).
SHOP_PUBLIC_URL=
# The shop's receiving bank account, shown to customers who pay a deposit (at least 10%) or in full at checkout.
# Empty: customers are told the shop will send the account details.
SHOP_BANK_NAME=
SHOP_BANK_ACCOUNT=
SHOP_BANK_HOLDER=
# Delivery through SuperAI (docs/business/deposit-delivery-specification.md): every carrier is quoted for the address and
# checkout uses the cheapest. SUPERAI_TOKEN is the static API token (SuperAI → Tích hợp API). SuperAI has no sandbox:
# SUPERAI_ORDER_MODE=simulate (default) quotes for real but creates SIM... waybills; live books real carriers.
SUPERAI_TOKEN=
# SUPERAI_ORDER_MODE=simulate
# The most the carrier collects on delivery; checkout asks for a larger upfront payment above it.
# SHIPPING_COD_LIMIT_VND=50000000
# Secret in the status webhook URL https://<shop>/api/shipping/superai/webhook?token=... (Admin → Delivery registers it).
SUPERAI_WEBHOOK_TOKEN=
# Public HTTPS base for provider webhooks when SHOP_PUBLIC_URL is not reachable (a tunnel in development).
# WEBHOOK_PUBLIC_URL=
# Address suggestions and map positions from OpenStreetMap data: photon (default, photon.komoot.io) or nominatim
# (openstreetmap.org, blocked by some Vietnamese networks); GEOCODER_URL for a self-hosted instance.
# GEOCODER_PROVIDER=photon
# GEOCODER_URL=
# GEOCODER_EMAIL=
# Online payment with payOS (https://my.payos.vn): webhook URL https://<shop>/api/payments/payos/webhook.
# PAYOS_LINK_MINUTES is also the checkout QR countdown (the order is created only once the payment arrives).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# PAYOS_LINK_MINUTES=30
# Orders placed without their upfront payment (manual transfer) are cancelled after this many hours.
# ORDER_PAYMENT_HOURS=24
# Shop alerts on a Zalo Official Account (live) or only in Admin -> Operational alerts (off); customer shipping
# updates by Zalo ZNS with one approved template whose parameters are order_code, tracking_code and status.
ZALO_MODE=off
ZALO_OA_ACCESS_TOKEN=
ZALO_ADMIN_USER_IDS=
ZALO_ZNS_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_ID=
# Ad platforms and the Facebook Page (docs/MARKETING_LIVE_CHECKLIST.md). `fake` (the default) never calls out and
# simulates metrics; `live` needs the credentials below, or the server refuses to start. Web only: never give these
# to the agent.
FACEBOOK_PAGE_MODE=fake
META_ADS_MODE=fake
GOOGLE_ADS_MODE=fake
TIKTOK_ADS_MODE=fake
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v24.0
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_IDENTITY_ID=
# Server-side purchase events for the configured tags above: `fake` records the payloads (conversion_event), `live`
# sends them (Meta Conversions API, TikTok Events API, Google Ads offline conversions by gclid).
CONVERSIONS_MODE=fake
META_CAPI_TOKEN=
TIKTOK_EVENTS_TOKEN=
GOOGLE_ADS_CONVERSION_ACTION_ID=

# Deterministic seed history (yarn seed-dev / seed-ci): the same values give the same shop data.
# SEED_NOW=2026-09-30T00:00:00Z          # default: now
# SEED_RANDOM_SEED=7
# SEED_HISTORY_DAYS=180

# Uploaded images (served under /uploads); defaults to ./uploads
UPLOAD_DIR=
# Maximum size of one uploaded image in MB (default 5)
UPLOAD_MAX_MB=5

# Google OAuth web client. Callback: <SHOP_PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database settings
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Log settings
LOGGER=CONSOLE
LOG_LEVEL=debug

# Auth settings
# Secret used to sign session JWTs (use a long random string)
JWT_SECRET=
# Session lifetime in seconds (default 604800 = 7 days)
JWT_EXPIRES_IN=604800
# Session cookie is Secure in production by default; set to false only when serving over plain HTTP
# COOKIE_SECURE=false

# First admin account, created by the seed (yarn seed-dev / seed-prod)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shop agent (apps/agent-service). Leave empty to disable the Agent API and the agent console.
# The Agent Server, called by the /api/admin/agent/server gateway (`poe dev` serves it on 2024).
AGENT_SERVER_URL=http://localhost:2024
# Bearer token the agent uses for /api/agent/v1 (= SHOP_API_TOKEN in the agent's .env)
AGENT_API_TOKEN=
# Signs the short-lived actor tokens sent to the agent (= AGENT_ACTOR_SECRET there). At least 32 bytes, not JWT_SECRET.
AGENT_ACTOR_SECRET=
# Signs approval grants (web only; the agent never holds it). At least 32 bytes, different from the secrets above.
AGENT_APPROVAL_SECRET=

# SMTP settings for OTP emails (when SMTP_HOST is empty in development, the OTP is written to the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Uploaded images (served under /uploads); defaults to ./uploads
UPLOAD_DIR=
# Maximum size of one uploaded image in MB (default 5)
UPLOAD_MAX_MB=5

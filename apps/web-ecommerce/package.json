{
  "name": "@model-universe/web",
  "version": "1.3.4",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development TURBOPACK=1 PORT=6050 ts-node --transpile-only server.ts",
    "dev:webpack": "cross-env NODE_ENV=development TURBOPACK= PORT=6050 ts-node --transpile-only server.ts",
    "seed-dev": "cross-env SEED_DATA=true DROP_TABLES=true NODE_ENV=development PORT=5050 ts-node server.ts",
    "seed-prod": "cross-env SEED_DATA=true DROP_TABLES=true NODE_ENV=production ts-node server.ts",
    "build": "cross-env NODE_ENV=production next build && tsc --project tsconfig.server.json",
    "start": "node dist/.next/server.js",
    "lint": "next lint",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.server.json",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "test": "jest --selectProjects unit",
    "test:db": "jest --selectProjects db --runInBand",
    "test-vectors": "ts-node scripts/test-vectors.ts",
    "seed-ci": "ts-node scripts/seed.ts",
    "db:migrate": "ts-node scripts/migrate.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "@langchain/core": "^1.2.13",
    "@langchain/langgraph-sdk": "^1.12.0",
    "apexcharts": "^3.45.2",
    "axios": "^1.7.4",
    "bcryptjs": "^2.4.3",
    "camelcase-keys": "^9.1.3",
    "cookie-parser": "^1.4.7",
    "cross-env": "^7.0.3",
    "csv-parse": "^7.0.3",
    "express": "^4.19.2",
    "facebook-nodejs-business-sdk": "^24.0.1",
    "google-ads-api": "^25.1.0",
    "gsap": "^3.15.0",
    "jose": "^5.9.6",
    "lottie-web": "^5.13.0",
    "multer": "^2.0.2",
    "next": "^14.2.4",
    "next-intl": "3",
    "nodemailer": "^6.9.16",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "react": "^18",
    "react-apexcharts": "^1.4.1",
    "react-dom": "^18",
    "react-promise-tracker": "^2.1.1",
    "react-toastify": "^10.0.5",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.3",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@swc/core": "^1.7.0",
    "@swc/helpers": "^0.5.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4",
    "@types/facebook-nodejs-business-sdk": "^24.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.1.0",
    "jest": "^30.5.2",
    "nock": "^14.0.17",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "pretty-quick": "^4.0.0",
    "supertest": "^7.3.0",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "packageManager": "yarn@4.3.1",

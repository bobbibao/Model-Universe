# Copy to apps/agent-service/.env (git-ignored). Secrets never go in this file.
# Full inventory: docs/plans/2026-09-30-agent-v2-refactor-and-growth-agent.md, section 3.

# --- Runtime ---
APP_ENV=dev                              # dev | test | production (production refuses placeholder secrets)
AGENT_LANGUAGE=vi                        # text written for people

# --- Models (config/llm/<profile>.yaml; docs/LOCAL_LLM.md) ---
LLM_PROFILE=local                        # local | local-small | local-large | anthropic | openai | google | scripted
# LLM_MODEL_PLANNER=ollama:qwen3.5:9b    # per-role override: provider:model
OLLAMA_BASE_URL=http://localhost:11434
LLM_DAILY_BUDGET_USD=2
# Keys come from your environment, never from the repo:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Databases ---
# The agent's own database (pgvector knowledge base): infra/sql/shop_agent.sql
DATABASE_URL=postgresql://shop_agent:<shop_agent password>@localhost:5432/shop_agent
# Read-only analytics views of the web shop: infra/sql/ci_reader.sql
SHOP_READ_DSN=postgresql://ci_reader:<ci_reader password>@localhost:5432/web_ecommerce

# --- Shop access ---
SHOP_ADAPTER=sql                         # sql | fake (development) | http (server tests)
SHOP_API_BASE_URL=http://localhost:6050/api/agent/v1
SHOP_API_TOKEN=change-me                 # the web's AGENT_API_TOKEN

# --- Auth: actor tokens minted by the web gateway (same value as the web's AGENT_ACTOR_SECRET) ---
AGENT_ACTOR_SECRET=change-me

# --- Loop timing ---
APPROVAL_TTL_HOURS=48
SIGNAL_COOLDOWN_HOURS=72
# DEMO_MEASURE_AFTER_MINUTES=2           # demo only, refused with APP_ENV=production

# --- Feature flags ---
# FF_GROWTH=true
# FF_MARKET_TRENDS=true
# FF_MARKET_SCRAPING=true                # competitors' own sites only; marketplaces are always denylisted

# --- Market data ---
# GOOGLE_TRENDS_CREDENTIALS=

# --- Tracing (Langfuse; unset = off). Dev-only optional: LANGSMITH_TRACING, LANGSMITH_API_KEY ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Tests ---
# AGENT_TEST_DATABASE_URL=postgresql://shop_agent_test:<password>@localhost:5432/shop_agent_test

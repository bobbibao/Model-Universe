{
  "$schema": "https://langgra.ph/schema.json",
  "python_version": "3.12",
  "dependencies": [
    "."
  ],
  "graphs": {
    "marketing_copy": {
      "path": "./src/shop_agent/graphs/marketing_copy.py:graph",
      "description": "Read-only editable marketing copy for admin drafts."
    },
    "improvement": {
      "path": "./src/shop_agent/graphs/improvement.py:graph",
      "description": "Closed loop for one opportunity."
    },
    "monitor": {
      "path": "./src/shop_agent/graphs/monitor.py:graph",
      "description": "Scheduled: sync, guard, sweep, detect, prioritize, open threads."
    },
    "collect": {
      "path": "./src/shop_agent/graphs/collect.py:graph",
      "description": "Scheduled: read market sources, post observations."
    },
    "assistant": {
      "path": "./src/shop_agent/graphs/assistant.py:graph",
      "description": "Shop operations copilot."
    }
  },
  "auth": {
    "path": "./src/shop_agent/auth.py:auth"
  },
  "store": {
    "index": {
      "embed": "./src/shop_agent/knowledge/embeddings.py:aembed",
      "dims": 1024,
      "fields": [
        "text"
      ]
    }
  },
  "env": ".env"
}
